Algoritmo suma_de_perimetros
	Definir n1, n2, n3, n4, suma, producto Como Real;
	Escribir "Ingrese el primer numero";
	Leer n1;
	Escribir "ingrese el segundo numero";
	Leer n2;
	Escribir "ingrese el tercer numero";
	Leer n3;
	Escribir "ingrese el cuarto numero";
	Leer n4;
	suma <- n1 * n2;
	producto <- n3 * n4;
	Escribir "la suma de los dos primero es: ", suma;
	Escribir " el producto del tercero y el cuarto es: ", producto;
	
	
	
	
	
	
FinAlgoritmo
